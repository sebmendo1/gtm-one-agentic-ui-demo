# Copy to .env.local and fill in. See docs/specs/07-agentic-harness.md.

# Jev (TypeSafe) — required. Picks surface, job, purpose, and sections.
TYPESAFE_API_KEY=

# ─── Gemini key goes here ─────────────────────────────────────────────
# Gemini Flash plans GTM CLI calls and writes the cited briefing.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# ──────────────────────────────────────────────────────────────────────

# GTM data source: auto (real `gtm` CLI when installed + signed in, else fixtures) | cli | fixtures
GTM_DATA_SOURCE=auto
# Optional: use another gtm binary instead of the bundled @zoominfo/gtm-ai-cli (e.g. a Homebrew install)
GTM_CLI_BIN=

# Signs the evidence a reply carries into follow-up turns (docs/specs/07-agentic-harness.md § Evidence carry).
# Optional: defaults to a key derived from TYPESAFE_API_KEY. Set it to rotate carried evidence independently.
HARNESS_SECRET=
